{
  "schema": 1,
  "id": "io.github.artcraftandroid.effects",
  "name": "Effects",
  "version": "1.0.0",
  "holds": ["filter"],
  "publisher": { "name": "ProCraft" },
  "description": "Filters for Adjustments: the lines of a scanned drawing kept off the paper, an outline, and colours held to a few flat steps.",
  "compat": { "procraft": { "interface": 5 } },
  "permissions": [],
  "controls": [
    { "key": "extract_lines", "type": "switch", "label": "Extract lines" },
    {
      "key": "cut", "type": "slider", "label": "Paper", "least": 0, "most": 1, "step": 0.01, "starts": 0.15,
      "shown_times": 100, "unit": "%", "live": true, "under": "extract_lines"
    },
    {
      "key": "soft", "type": "slider", "label": "Softness", "least": 0, "most": 0.5, "step": 0.01, "starts": 0.1,
      "shown_times": 100, "unit": "%", "live": true, "under": "extract_lines"
    },
    { "key": "keep_colour", "type": "switch", "label": "Keep the colour", "starts": false, "under": "extract_lines" },
    { "key": "outline", "type": "switch", "label": "Outline" },
    {
      "key": "reach", "type": "slider", "label": "Width", "least": 1, "most": 12, "step": 1, "starts": 3, "unit": " px",
      "live": true, "under": "outline"
    },
    { "key": "posterise", "type": "switch", "label": "Posterise" },
    { "key": "steps", "type": "slider", "label": "Steps", "least": 2, "most": 16, "step": 1, "starts": 4, "live": true, "under": "posterise" }
  ],
  "filters": [
    { "key": "extract_lines", "label": "Extract lines", "controls": ["cut", "soft", "keep_colour"], "under": "extract_lines" },
    { "key": "outline", "label": "Outline", "controls": ["reach"], "under": "outline" },
    { "key": "posterise", "label": "Posterise", "controls": ["steps"], "under": "posterise" }
  ],
  "replaces": [
    { "id": "io.github.artcraftandroid.extract-lines", "switch": "extract_lines" },
    { "id": "io.github.artcraftandroid.outline", "switch": "outline" },
    { "id": "io.github.artcraftandroid.posterise", "switch": "posterise" }
  ]
}
